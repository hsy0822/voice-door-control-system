# 监听（与方案一致：8002）
VPR_SER_HOST=0.0.0.0
VPR_SER_PORT=8002

# 数据与模型缓存目录（可绝对路径）
VPR_SER_DATA_DIR=
VPR_SER_MODELS_DIR=
VPR_SER_TEMP_DIR=
VPR_SER_LOG_DIR=

# 启动时是否预加载模型（0 关闭，加快启动但首请求慢）
VPR_SER_PRELOAD=1

# cpu 或 cuda:0
VPR_SER_DEVICE=cpu

# 与后端 voiceprints 目录对齐时，可在无显式 enroll 时从 seg1–3.wav 自动生成注册向量
# 例：Windows  VOICEPRINTS_ROOT=C:\path\to\voice-door-control-system\backend\data\voiceprints
VOICEPRINTS_ROOT=

# SpeechBrain Hub 模型 ID（可换为镜像或本地克隆路径）
SPKREC_SOURCE=speechbrain/spkrec-ecapa-voxceleb
EMOTION_SOURCE=speechbrain/emotion-recognition-wav2vec2-IEMOCAP

# 声纹余弦相似度阈值（越高越严）
VOICE_MATCH_THRESHOLD=0.32

# 胁迫相关标签子串（逗号分隔，不区分大小写匹配）
DURESS_SUBSTRINGS=ang,sad,fear,fea,fru,disg,anx,anger,scared,frustrat

# 非中性且 softmax 最大概率超过该值时，辅助判胁迫
DURESS_MIN_PROB=0.55

# 与 ASR 门禁短音一致
VPR_MIN_DURATION_SEC=0.5
VPR_MAX_DURATION_SEC=5.0
