# ---------- Hugging Face（首次拉模型）----------
# 未设置 HF_ENDPOINT 时，程序会默认使用 https://hf-mirror.com（见 app/engine.py）。
# 必须用官方 Hub 时（海外网络等）二选一：
#   HF_USE_OFFICIAL_HUB=1
# 或显式：HF_ENDPOINT=https://huggingface.co
#
# 自定义镜像：HF_ENDPOINT=https://你的镜像地址
# 不注入 k2 占位模块（一般勿改）：VPR_SKIP_K2_STUB=1
# HF_HUB_DOWNLOAD_TIMEOUT=180
# HF_HUB_OFFLINE=1
# HF 缓存禁用 symlink（Windows 常见）
# HF_HUB_DISABLE_SYMLINKS=1

# SpeechBrain：把 Hub 文件拷到 savedir，而非 symlink（默认等价 COPY，避免 WinError 1314）
# SB_FETCH_LOCAL_STRATEGY=COPY
# 若已开启 Windows 开发者模式且想用 symlink：SB_FETCH_LOCAL_STRATEGY=SYMLINK

# 监听（与方案一致：8002）
VPR_SER_HOST=0.0.0.0
VPR_SER_PORT=8002

# 数据与模型缓存目录（可绝对路径）
VPR_SER_DATA_DIR=
VPR_SER_MODELS_DIR=
VPR_SER_TEMP_DIR=
VPR_SER_LOG_DIR=

# 启动时是否预加载模型（0 关闭，加快启动但首请求慢）
VPR_SER_PRELOAD=1

# cpu 或 cuda:0
VPR_SER_DEVICE=cpu

# 与后端 voiceprints 目录对齐时，可在无显式 enroll 时从 seg1–3.wav 自动生成注册向量
# 例：Windows  VOICEPRINTS_ROOT=C:\path\to\voice-door-control-system\backend\data\voiceprints
VOICEPRINTS_ROOT=

# SpeechBrain Hub 模型 ID（可换为镜像或本地克隆路径）
SPKREC_SOURCE=speechbrain/spkrec-ecapa-voxceleb
EMOTION_SOURCE=speechbrain/emotion-recognition-wav2vec2-IEMOCAP
# SpeechBrain 情感失败时（如缺少 k2）自动改用 transformers，模型 ID 可换
EMOTION_HF_MODEL=superb/wav2vec2-base-superb-er

# 声纹余弦相似度阈值（越高越严）
VOICE_MATCH_THRESHOLD=0.32

# 胁迫相关标签子串（逗号分隔，不区分大小写匹配）
DURESS_SUBSTRINGS=ang,sad,fear,fea,fru,disg,anx,anger,scared,frustrat

# 非中性且 softmax 最大概率超过该值时，辅助判胁迫
DURESS_MIN_PROB=0.55

# 与 ASR 门禁短音一致
VPR_MIN_DURATION_SEC=0.35
VPR_MAX_DURATION_SEC=5.0
