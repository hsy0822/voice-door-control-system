# 监听
HOST=0.0.0.0
PORT=8000

# 数据目录（SQLite 与声纹 wav）
DATA_DIR=

# JWT（生产环境务必修改）
SECRET_KEY=

# 首次启动默认管理员（若库中尚无管理员则创建）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ASR 服务 verify 接口（与 ai-asr 默认端口一致时可不改）
ASR_VERIFY_URL=http://127.0.0.1:8090/api/v1/verify

# 声纹 / 情感：须指向 ai-vpr-ser（默认 8002）。留空且未开下面“假通过”时，门禁声纹一律不通过。
VOICE_VERIFY_URL=http://127.0.0.1:8002/api/v1/voice/verify
EMOTION_ANALYZE_URL=http://127.0.0.1:8002/api/v1/emotion/analyze

AI_HTTP_TIMEOUT_SEC=120

# 未配置 VOICE_VERIFY_URL 时，若 seg1–3.wav 齐全也视为声纹通过（不做比对，仅本地演示）
VOICE_VERIFY_ALLOW_SEGMENTS_STUB=false

# 联调占位（勿用于生产）
MOCK_VOICEPRINT_MATCH=false
MOCK_EMOTION_DURESS=false

# CORS：逗号分隔来源，或 * 
CORS_ORIGINS=*
