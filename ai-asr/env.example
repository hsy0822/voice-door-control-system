# 复制为 .env 或直接在系统环境中设置（本服务也可用默认值）
ASR_HOST=0.0.0.0
ASR_PORT=8090
WHISPER_MODEL=base
# whisper（默认）| funasr（需安装 requirements-funasr.txt，Linux/ECS 更推荐）
ASR_ENGINE=whisper
FUNASR_MODEL=paraformer-zh
ASR_DEVICE=cpu
ASR_MAX_CONCURRENT=2
ASR_MAX_UPLOAD_BYTES=8388608
# 算术题下单字语气词是否丢弃（1=丢弃，易表现为 NO_SPEECH；0=保留原字便于对照）
# ASR_DROP_ARITHMETIC_SINGLE_GARBAGE=1
# 最短有效语音（秒），默认 0.5
# ASR_MIN_DURATION_SEC=0.5
# 可选：与 VPR/SER 共用父目录时指定临时目录，避免文件名冲突（默认 ai-asr/temp）
# ASR_TEMP_DIR=/tmp/voice-door-shared
